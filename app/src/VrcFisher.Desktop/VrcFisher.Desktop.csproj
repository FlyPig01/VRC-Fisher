<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>VrcFisher.Desktop</RootNamespace>
    <AssemblyName>VrcFisher</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseRidGraph>true</UseRidGraph>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\assets\branding\VRC-Fisher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VrcFisher.Core\VrcFisher.Core.csproj" />
    <ProjectReference Include="..\VrcFisher.Application\VrcFisher.Application.csproj" />
    <ProjectReference Include="..\VrcFisher.Infrastructure\VrcFisher.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Include="Strings\**\*.resw" />
    <Content Include="..\..\..\assets\branding\VRC-Fisher.ico"
             Link="Assets\VRC-Fisher.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\assets\branding\VRC-Fisher.svg"
             Link="Assets\VRC-Fisher.svg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\assets\worlds\wrld_ae001ea3-ed05-42f0-adf2-3d47efd10a77\cover.jpg"
             Link="Assets\Worlds\wrld_ae001ea3-ed05-42f0-adf2-3d47efd10a77\cover.jpg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveWinUiDirectMlPublishConflict"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_HandleFileConflictsForPublish"
          Condition="'$(VrcExecutionProvider)' == 'DirectML'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'DirectML.dll' and $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('\MsixContent\'))" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeApplicationPriInPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)VrcFisher.pri"
          Condition="Exists('$(TargetDir)VrcFisher.pri')"
          RelativePath="VrcFisher.pri"
          CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
