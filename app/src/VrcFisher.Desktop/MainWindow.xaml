<Window
    x:Class="VrcFisher.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="16" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="AppTitleText" Text="VRC-Fisher" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusBadge" Text="Models not ready" VerticalAlignment="Center" />
        </StackPanel>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="RunNavigationItem" Content="Run" Tag="run" />
                <NavigationViewItem x:Name="ModelsNavigationItem" Content="Models" Tag="models" />
                <NavigationViewItem x:Name="SettingsNavigationItem" Content="Settings" Tag="settings" />
                <NavigationViewItem x:Name="DiagnosticsNavigationItem" Content="Diagnostics" Tag="diagnostics" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
